---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title,
  description = 'Callijatra Foundation preserves, promotes, and digitizes indigenous scripts and calligraphy such as Ranjana Lipi and Nepal Lipi through free fonts, mobile apps, web widgets, and learning resources.',
  ogImage = '/images/banners/banner_1.jpg',
} = Astro.props;

const siteName = 'Callijatra Foundation';
const siteOrigin = Astro.site ? Astro.site.href : 'https://callijatra.github.io/';
const canonicalURL = Astro.props.canonicalURL ?? new URL(Astro.url.pathname, siteOrigin).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Callijatra, Ranjana, Ranjana Lipi, Callijatra Foundation, Nepal Lipi, Newa Lipi, Nepal Bhasa, Calligraphy, Ranjana Font, Durga Lal Shrestha font, Nithya Ranjana, Newa font, Newa script, Ranjana webfont, Newa converter, Unicode Converter, Nepal Lipi Keyboard, Callijatra Calligraphy" />
    <meta name="author" content="Callijatra Foundation" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="google-site-verification" content="rAbHETTiaHIHsNQlDCAcJTmLdY2-wsHPEHXlwybh_5E" />

    <!-- Search Engine Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="bingbot" content="index, follow" />
    <meta name="theme-color" content="#c0392b" />
    <meta name="application-name" content="Callijatra Foundation" />

    <!-- Open Graph (Facebook, LinkedIn, Discord, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:alt" content="Callijatra Foundation — Ranjana & Nepal Lipi Digital Heritage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ne_NP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content="Callijatra Foundation — Ranjana & Nepal Lipi Digital Heritage" />

    <link rel="icon" href="/images/logos/callijatra_logo.svg" type="image/svg+xml" />

    <!-- Schema.org JSON-LD Structured Data for Search Engines -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://callijatra.github.io/#organization",
          "name": "Callijatra Foundation",
          "alternateName": ["Callijatra", "क्यालिजात्रा फाउण्डेशन"],
          "url": "https://callijatra.github.io/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://callijatra.github.io/images/logos/callijatra_logo.svg"
          },
          "sameAs": [
            "https://github.com/callijatra",
            "https://www.instagram.com/callijatra",
            "https://play.google.com/store/apps/developer?id=Callijatra"
          ],
          "description": "Callijatra Foundation is a non-profit cultural initiative preserving, promoting, and digitizing indigenous scripts and calligraphy such as Ranjana Lipi and Nepal Lipi."
        },
        {
          "@type": "WebSite",
          "@id": "https://callijatra.github.io/#website",
          "url": "https://callijatra.github.io/",
          "name": "Callijatra Foundation",
          "alternateName": "Callijatra - Ranjana & Nepal Lipi Digital Heritage",
          "publisher": {
            "@id": "https://callijatra.github.io/#organization"
          },
          "inLanguage": ["en", "ne", "new"]
        }
      ]
    })} />

    <!-- Apply dark mode before paint to prevent flash -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 antialiased">

    <!-- NAVBAR -->
    <header class="sticky top-0 z-50 bg-white/90 dark:bg-gray-950/90 backdrop-blur border-b border-gray-100 dark:border-gray-800 shadow-sm">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <img src="/images/logos/callijatra_logo.svg" alt="Callijatra Foundation Logo"
               class="h-10 w-auto dark:brightness-0 dark:invert" />
        </a>

        <!-- Desktop nav -->
        <ul class="hidden md:flex items-center gap-1 text-sm font-medium">
          <li><a href="/" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Home</a></li>
          <li><a href="/resources" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Resources</a></li>
          <li><a href="/learn" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Learn</a></li>
          <li><a href="/gallery" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Gallery</a></li>
          <li><a href="/about" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">About Us</a></li>
          <li>
            <a href="https://www.instagram.com/callijatra" target="_blank" rel="noopener noreferrer"
               class="ml-2 px-4 py-2 rounded-lg bg-brand text-white hover:bg-brand-hover transition-colors">
              Contact
            </a>
          </li>
        </ul>

        <!-- Right side: dark mode toggle + hamburger -->
        <div class="flex items-center gap-2">

          <!-- Dark mode toggle -->
          <button id="theme-toggle" aria-label="Toggle dark mode"
            class="p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <!-- Sun icon (shown in dark mode) -->
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 3v1m0 16v1m8.66-9H21M3 12H2m15.36-6.36-.71.71M6.34 17.66l-.71.71M17.66 17.66l-.71-.71M6.34 6.34l-.71-.71M12 5a7 7 0 1 0 0 14A7 7 0 0 0 12 5z" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>

          <!-- Mobile hamburger -->
          <button id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false"
            class="md:hidden p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <svg id="nav-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path id="bar-top"    stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16" />
              <path id="bar-middle" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16" />
              <path id="bar-bottom" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16" />
            </svg>
          </button>

        </div>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="nav-collapsed md:hidden border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 px-4 pb-4">
        <ul id="mobile-menu-list" class="flex flex-col gap-1 text-sm font-medium mt-2">
          <li><a href="/" class="nav-link block px-3 py-3 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">Home</a></li>
          <li><a href="/resources" class="nav-link block px-3 py-3 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">Resources</a></li>
          <li><a href="/learn" class="nav-link block px-3 py-3 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">Learn</a></li>
          <li><a href="/gallery" class="nav-link block px-3 py-3 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">Gallery</a></li>
          <li><a href="/about" class="nav-link block px-3 py-3 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">About Us</a></li>
          <li><a href="https://www.instagram.com/callijatra" target="_blank" rel="noopener noreferrer" class="nav-link block px-3 py-3 rounded-lg text-brand hover:bg-red-50 dark:hover:bg-red-950">Contact</a></li>
        </ul>
      </div>
    </header>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-gray-900 dark:bg-gray-950 text-gray-300 py-10 mt-16 border-t border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8 items-start">

          <!-- Brand -->
          <div>
            <img src="/images/logos/callijatra_logo.svg" alt="Callijatra Logo" class="h-10 mb-3 brightness-0 invert" />
            <p class="text-sm text-gray-400 leading-relaxed max-w-xs">
              Promoting indigenous scripts through technology, education, and design.
            </p>
          </div>

          <!-- Social -->
          <div>
            <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Connect</h3>
            <div class="grid grid-cols-2 gap-3 md:gap-4">


              <!-- Instagram -->
              <a href="https://www.instagram.com/callijatra" target="_blank" rel="noopener noreferrer"
                 class="group flex items-center gap-3 text-sm text-gray-400 hover:text-white transition-colors">
                <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-gray-800 group-hover:bg-gradient-to-br group-hover:from-purple-600 group-hover:via-pink-500 group-hover:to-orange-400 transition-all duration-200 shrink-0">
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </span>
                Instagram
              </a>

              <!-- Facebook -->
              <a href="https://www.facebook.com/ranjana-script" target="_blank" rel="noopener noreferrer"
                 class="group flex items-center gap-3 text-sm text-gray-400 hover:text-white transition-colors">
                <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-gray-800 group-hover:bg-[#1877F2] transition-all duration-200 shrink-0">
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </span>
                Facebook
              </a>

              <!-- YouTube -->
              <a href="https://www.youtube.com/@callijatra" target="_blank" rel="noopener noreferrer"
                 class="group flex items-center gap-3 text-sm text-gray-400 hover:text-white transition-colors">
                <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-gray-800 group-hover:bg-[#FF0000] transition-all duration-200 shrink-0">
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </span>
                YouTube
              </a>

              <!-- GitHub -->
              <a href="https://github.com/callijatra" target="_blank" rel="noopener noreferrer"
                 class="group flex items-center gap-3 text-sm text-gray-400 hover:text-white transition-colors">
                <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-gray-800 transition-all duration-200 shrink-0">
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.82 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                  </svg>
                </span>
                GitHub
              </a>

              <!-- Email -->
              <a href="mailto:callijatrafoundation@gmail.com"
                 class="group flex items-center gap-3 text-sm text-gray-400 hover:text-white transition-colors">
                <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-gray-800 group-hover:bg-[#EA4335] transition-all duration-200 shrink-0">
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </span>
                Email
              </a>

            </div>
          </div>
        </div>

        <div class="border-t border-gray-800 pt-6 text-sm text-gray-500 flex flex-col sm:flex-row justify-between items-center gap-2 text-center sm:text-left">
          <p>© {new Date().getFullYear()} Callijatra Foundation. All rights reserved.</p>
          <p>Built with <a href="https://astro.build" class="hover:text-white transition-colors">Astro</a></p>
        </div>
      </div>
    </footer>

    <!-- Scripts: dark mode toggle + mobile nav -->
    <script>
      // ── Dark mode ──────────────────────────────────────────────────────
      const html = document.documentElement;
      const themeToggle = document.getElementById('theme-toggle');
      const iconSun = document.getElementById('icon-sun');
      const iconMoon = document.getElementById('icon-moon');

      function applyTheme(dark: boolean) {
        html.classList.toggle('dark', dark);
        iconSun?.classList.toggle('hidden', !dark);
        iconMoon?.classList.toggle('hidden', dark);
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      }

      // Sync icon state on load
      applyTheme(html.classList.contains('dark'));

      themeToggle?.addEventListener('click', () => {
        applyTheme(!html.classList.contains('dark'));
      });

      // ── Mobile nav ────────────────────────────────────────────────────
      const navToggle = document.getElementById('nav-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuItems = document.querySelectorAll('#mobile-menu-list > li');
      const barTop = document.getElementById('bar-top');
      const barMiddle = document.getElementById('bar-middle');
      const barBottom = document.getElementById('bar-bottom');

      const OPEN_DELAY = 0;      // stagger start for menu items (0ms so they start animating after height)
      const STEP_DELAY = 30;     // delay between each menu item
      const CLOSE_WAIT = 200;    // matches menu close transition

      function setMenu(open: boolean) {
        navToggle?.setAttribute('aria-expanded', String(open));

        barTop?.setAttribute('d', open ? 'M6 6l12 12' : 'M4 6h16');
        barMiddle?.setAttribute('opacity', open ? '0' : '1');
        barBottom?.setAttribute('d', open ? 'M18 6L6 18' : 'M4 18h16');

        menuItems.forEach((item, i) => {
          const el = item as HTMLElement;
          if (open) {
            el.style.transitionDelay = `${i * STEP_DELAY}ms`;
            el.classList.remove('menu-item-hidden');
          } else {
            el.style.transitionDelay = '0ms';
            el.classList.add('menu-item-hidden');
          }
        });

        if (open) {
          // Calculate actual height and set it for animation
          mobileMenu?.classList.remove('nav-collapsed');
          mobileMenu?.classList.add('nav-open');
          if (mobileMenu) {
            mobileMenu.style.height = 'auto';
            const targetHeight = mobileMenu.scrollHeight;
            mobileMenu.style.height = '0px';
            // Force reflow
            void mobileMenu.offsetHeight;
            mobileMenu.style.height = `${targetHeight}px`;
          }
        } else {
          // Animate height to 0 then collapse
          if (mobileMenu) {
            mobileMenu.style.height = `${mobileMenu.scrollHeight}px`;
            // Force reflow
            void mobileMenu.offsetHeight;
            mobileMenu.style.height = '0px';
          }
          window.setTimeout(() => {
            mobileMenu?.classList.remove('nav-open');
            mobileMenu?.classList.add('nav-collapsed');
          }, CLOSE_WAIT);
        }
      }

      // Hide items initially (no flash when CSS is still loading)
      menuItems.forEach((item) => (item as HTMLElement).classList.add('menu-item-hidden'));

      navToggle?.addEventListener('click', () => {
        const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
        setMenu(!isOpen);
      });

      mobileMenu?.querySelectorAll('a.nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          setMenu(false);
        });
      });
    </script>
    <!-- Bottom FAB dock: optional leading slot (e.g. learn filter) + scroll to top -->
    <div
      id="fab-dock"
      class="fixed bottom-4 right-3 sm:bottom-6 sm:right-6 z-50 flex flex-col-reverse items-end sm:flex-row sm:items-end max-w-[calc(100vw-0.75rem)] sm:max-w-[calc(100vw-1.5rem)] pb-[env(safe-area-inset-bottom)]"
    >
      <div id="fab-dock-leading" class="w-max"></div>
      <button
        id="scroll-top"
        aria-label="Scroll to top"
        class="scroll-top-btn inline-flex items-center justify-center shrink-0 rounded-full bg-brand text-white shadow-lg
               opacity-0 w-0 h-0 p-0 m-0 overflow-hidden pointer-events-none
               transition-all duration-300 ease-out
               hover:bg-brand-hover active:scale-90"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
      </button>
    </div>

    <script>
      const btn = document.getElementById('scroll-top');
      function syncBtn() {
        const visible = window.scrollY > 300;
        btn?.classList.toggle('opacity-0', !visible);
        btn?.classList.toggle('opacity-100', visible);
        btn?.classList.toggle('w-0', !visible);
        btn?.classList.toggle('h-0', !visible);
        btn?.classList.toggle('p-0', !visible);
        btn?.classList.toggle('m-0', !visible);
        btn?.classList.toggle('w-11', visible);
        btn?.classList.toggle('h-11', visible);
        btn?.classList.toggle('p-3', visible);
        // Mobile: sit above the filter; sm+: sit to the right with a gap
        btn?.classList.toggle('mb-2', visible);
        btn?.classList.toggle('sm:mb-0', visible);
        btn?.classList.toggle('sm:ml-3', visible);
        btn?.classList.toggle('overflow-hidden', !visible);
        btn?.classList.toggle('pointer-events-none', !visible);
        document.documentElement.dataset.scrollTop = visible ? '1' : '0';
      }
      syncBtn();
      window.addEventListener('scroll', syncBtn, { passive: true });
      btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>

  </body>
</html>
