---
interface Props {
  store: 'google' | 'apple';
  href: string;
}
const { store, href } = Astro.props;
---

{store === 'google' && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Get it on Google Play"
    class="store-badge store-badge-google inline-flex items-center justify-center h-10 w-[8.4rem] overflow-hidden hover:opacity-85 active:scale-95 transition-all duration-150"
  >
    <!-- Official PNG includes ~16% vertical / ~6% horizontal transparent padding.
         Scale the image so the visible badge art is h-10, then clip the padding. -->
    <img
      src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
      alt="Get it on Google Play"
      class="h-[3.72rem] w-auto max-w-none shrink-0"
      loading="lazy"
    />
  </a>
)}

{store === 'apple' && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Download on the App Store"
    class="store-badge store-badge-apple inline-flex items-center h-10 hover:opacity-85 active:scale-95 transition-all duration-150"
  >
    <img
      src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
      alt="Download on the App Store"
      class="h-10 w-auto"
      loading="lazy"
    />
  </a>
)}
