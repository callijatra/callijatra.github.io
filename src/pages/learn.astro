---
import Layout from '../layouts/Layout.astro';
import RanjanaExplorer from '../components/learn/RanjanaExplorer.astro';
import { learnTopics } from '../data/ranjana-lipi';

const activeTopic = 'ranjana';
---

<Layout
  title="Learn — Ranjana Lipi Interactive Lessons | Callijatra"
  description="Learn Ranjana Lipi interactively — explore vowels, consonants, and matras with Devanagari mappings. Built for students and curious learners."
>

  <section class="min-h-[calc(100vh-4rem)] bg-gray-50 dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">

      <!-- Page intro -->
      <div class="mb-8">
        <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-2">Learning Space</span>
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-2">Learn with Callijatra</h1>
        <p class="text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed">
          Interactive lessons for Nepal’s indigenous scripts — start with Ranjana Lipi, then grow into Nepal Lipi and calligraphy crafts.
        </p>
      </div>

      <!-- Mobile topic picker -->
      <div class="lg:hidden mb-6 relative">
        <label for="topic-select" class="sr-only">Choose a lesson</label>
        <select
          id="topic-select"
          class="topic-select w-full appearance-none rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white pl-4 pr-12 py-3 text-sm font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-brand"
        >
          {learnTopics.map((topic) => (
            <option value={topic.id} selected={topic.id === activeTopic} disabled={!topic.available}>
              {topic.label}{!topic.available ? ' (Soon)' : ''}
            </option>
          ))}
        </select>
        <span class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-gray-400 dark:text-gray-500" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] gap-6 lg:gap-8 items-start">

        <!-- Sidebar -->
        <aside class="hidden lg:block sticky top-24" aria-label="Lesson topics">
          <nav class="rounded-2xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 p-3 shadow-sm">
            <p class="px-3 pt-2 pb-3 text-[10px] font-semibold tracking-widest uppercase text-gray-400">Topics</p>
            <ul class="space-y-1">
              {learnTopics.map((topic) => (
                <li>
                  {topic.available ? (
                    <a
                      href={`#${topic.id}`}
                      id={`nav-${topic.id}`}
                      class:list={[
                        'flex flex-col gap-0.5 rounded-xl px-3 py-3 transition-colors',
                        topic.id === activeTopic
                          ? 'bg-brand/10 dark:bg-brand/20 text-brand dark:text-brand-light'
                          : 'text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800',
                      ]}
                      aria-current={topic.id === activeTopic ? 'page' : undefined}
                    >
                      <span class="text-sm font-semibold leading-snug">{topic.label}</span>
                      <span class="text-xs opacity-70">{topic.description}</span>
                    </a>
                  ) : (
                    <div
                      class="flex flex-col gap-0.5 rounded-xl px-3 py-3 text-gray-400 dark:text-gray-600 cursor-not-allowed"
                      aria-disabled="true"
                    >
                      <span class="flex items-center gap-2 text-sm font-semibold leading-snug">
                        {topic.label}
                        <span class="text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">Soon</span>
                      </span>
                      <span class="text-xs">{topic.description}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Main lesson pane -->
        <div class="min-w-0">
          <div
            id="ranjana"
            class="learn-pane rounded-2xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm p-5 sm:p-7"
          >
            <div class="mb-6">
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-1">Learn Ranjana Lipi</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                Explore the alphabet, then open any consonant to see its matra family.
              </p>
            </div>
            <RanjanaExplorer />

            <section aria-labelledby="ranjana-typeface" class="mt-8 pt-8 border-t border-gray-100 dark:border-gray-800">
              <h3 id="ranjana-typeface" class="text-xs font-semibold tracking-widest uppercase text-gray-400 dark:text-gray-500">Typeface used in this lesson</h3>
              <div class="mt-4 grid grid-cols-1 sm:grid-cols-[minmax(0,11rem)_minmax(0,1fr)] gap-4 sm:gap-6 items-stretch">
                <div class="rounded-2xl border border-red-100/80 dark:border-gray-700 bg-[radial-gradient(ellipse_at_top,_#fdf1f0_0%,_#f9f5f4_70%)] dark:bg-none dark:bg-gray-950 flex items-center justify-center px-4 py-8">
                  <p class="font-nithya-ranjana text-5xl leading-none text-gray-900 dark:text-white">रञ्जना</p>
                </div>
                <div class="min-w-0">
                  <h4 class="text-lg font-bold text-gray-900 dark:text-white">Nithya Ranjana</h4>
                  <p class="mt-1 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    Letters, matras, and compounds in this lesson are drawn with Nithya Ranjana, a Ranjana typeface designed and engineered by EkType. This lesson uses the Devanagari Unicode version, so each Ranjana form sits next to its Devanagari mapping.
                  </p>
                  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
                    <a href="https://ektype.in" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand dark:text-brand-light hover:underline">EkType</a>
                    <span aria-hidden="true"> · </span>
                    <a href="/tools/webfont" class="font-semibold text-brand dark:text-brand-light hover:underline">Webfont</a>
                    <span aria-hidden="true"> · </span>
                    <a href="/tools/webfont/OFL.txt" class="font-semibold text-brand dark:text-brand-light hover:underline">SIL Open Font License</a>
                  </p>
                </div>
              </div>
            </section>
          </div>

          <!-- Coming-soon placeholders (hidden until selected; reserved for future) -->
          <div id="nepal-lipi" class="learn-pane hidden rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-10 text-center">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Learn Nepal Lipi</h2>
            <p class="text-gray-500 dark:text-gray-400">This lesson is on the way. Check back soon!</p>
          </div>
          <div id="calligraphy-pen" class="learn-pane hidden rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-10 text-center">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Craft a calligraphy pen</h2>
            <p class="text-gray-500 dark:text-gray-400">Tools and methods for Ranjana pens — coming soon.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const select = document.getElementById('topic-select') as HTMLSelectElement | null;
      select?.addEventListener('change', () => {
        const id = select.value;
        document.querySelectorAll('.learn-pane').forEach((pane) => {
          pane.classList.toggle('hidden', pane.id !== id);
        });
        // Only ranjana is available; reset if somehow disabled option selected
        if (id !== 'ranjana') {
          select.value = 'ranjana';
          document.getElementById('ranjana')?.classList.remove('hidden');
        }
      });
    })();
  </script>

</Layout>
