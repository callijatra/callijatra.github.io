---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Nepal Lipi Unicode Converter | Callijatra"
  description="Convert text between Devanagari and Nepal Lipi (Newa script) in real time."
>
  <link rel="stylesheet" href="/tools/converter/converter.css" />

    <!-- HERO HEADER SECTION -->
    <section class="relative pt-6 sm:pt-10 pb-4 sm:pb-6 overflow-hidden">
        <!-- Background Orbs -->
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-brand/5 blur-3xl pointer-events-none dark:hidden" aria-hidden="true"></div>
        <div class="absolute -bottom-16 -left-16 w-72 h-72 rounded-full bg-brand/5 blur-3xl pointer-events-none dark:hidden" aria-hidden="true"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
            <!-- Badge -->
            <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-[#fbeae9] text-[#c0392b] dark:bg-[#3b1212] dark:text-[#e8877f] border border-[#f5c6cb] dark:border-[#7f1d1d] mb-3 backdrop-blur-sm shadow-sm">
                <span class="font-newa text-sm sm:text-base">𑐣𑐾𑐥𑐵𑐮 𑐮𑐶𑐥𑐶</span>
                <span class="w-1.5 h-1.5 rounded-full bg-brand dark:bg-brand-light"></span>
                <span>OPEN DIGITAL TOOL</span>
            </div>

            <!-- Title -->
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white leading-tight">
                Devanagari <span class="text-brand dark:text-brand-light font-newa font-normal">↔</span> Nepal Lipi Converter
            </h1>

            <!-- Subtitle -->
            <p class="mt-2 text-xs sm:text-base text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed px-2">
                Convert text seamlessly between Devanagari and traditional <strong class="text-gray-900 dark:text-gray-200 font-semibold">Nepal Lipi (Newa script)</strong> in real-time. Preserving indigenous typography for everyone.
            </p>
        </div>
    </section>

    <!-- MAIN CONVERTER SECTION -->
    <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2 flex-1 w-full">
        
        <!-- TOOLBAR / QUICK CONTROLS CARD -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-3.5 sm:p-4 border border-gray-200/80 dark:border-gray-800 shadow-sm mb-4 sm:mb-5">
            <div class="flex flex-col gap-3.5">
                
                <!-- Quick Sample Presets -->
                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[11px] sm:text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider flex items-center gap-1 shrink-0 mr-1">
                        <svg class="w-3.5 h-3.5 text-brand dark:text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        Samples:
                    </span>
                    <button onclick="loadPreset('ज्वज्वलोपा')" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-brand/10 hover:text-brand dark:hover:bg-brand/20 dark:hover:text-brand-light transition-all">ज्वज्वलोपा</button>
                    <button onclick="loadPreset('नेपाल लिपि')" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-brand/10 hover:text-brand dark:hover:bg-brand/20 dark:hover:text-brand-light transition-all">नेपाल लिपि</button>
                    <button onclick="loadPreset('भिंतुना')" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-brand/10 hover:text-brand dark:hover:bg-brand/20 dark:hover:text-brand-light transition-all">भिंतुना</button>
                    <button onclick="loadPreset('सुभाय्')" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-brand/10 hover:text-brand dark:hover:bg-brand/20 dark:hover:text-brand-light transition-all">सुभाय्</button>
                    <button onclick="loadPreset('नेपाल संवत्')" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-brand/10 hover:text-brand dark:hover:bg-brand/20 dark:hover:text-brand-light transition-all">नेपाल संवत्</button>
                    <button onclick="loadPreset('०१२३४५६७८९')" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-brand/10 hover:text-brand dark:hover:bg-brand/20 dark:hover:text-brand-light transition-all">०१२३४५६७८९</button>
                </div>

                <!-- Controls Bar: Swap Panels, Font Size, Clear All -->
                <div class="flex items-center justify-between gap-2 flex-wrap pt-2 border-t border-gray-100 dark:border-gray-800">
                    <button onclick="swapPanels()" class="px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-brand hover:text-white dark:hover:bg-brand border border-gray-200 dark:border-gray-700/60 transition-all text-xs font-semibold flex items-center gap-1.5 shrink-0" title="Swap Left & Right Panels">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                        <span>Swap Panels</span>
                    </button>
                    
                    <div class="flex items-center gap-2 shrink-0">
                        <span class="text-[11px] sm:text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Font:</span>
                        <div class="flex items-center bg-gray-100 dark:bg-gray-800 p-0.5 sm:p-1 rounded-xl border border-gray-200 dark:border-gray-700/60">
                            <button id="btn-size-sm" onclick="setFontSize('sm')" class="font-size-btn px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium transition-all">S</button>
                            <button id="btn-size-md" onclick="setFontSize('md')" class="font-size-btn px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium bg-brand text-white transition-all">M</button>
                            <button id="btn-size-lg" onclick="setFontSize('lg')" class="font-size-btn px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium transition-all">L</button>
                            <button id="btn-size-xl" onclick="setFontSize('xl')" class="font-size-btn px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs font-medium transition-all">XL</button>
                        </div>

                        <button onclick="clearAll()" class="p-1.5 sm:p-2 rounded-xl text-gray-500 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40 dark:hover:text-red-400 border border-transparent hover:border-red-200 transition-all text-xs font-medium flex items-center gap-1" title="Clear all fields">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            <span class="inline">Clear</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2-COLUMN CONVERTER PANELS CONTAINER -->
        <div id="converter-grid-container" class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5 relative transition-all duration-300">

            <!-- DEVANAGARI PANEL CARD -->
            <div id="card-deva" class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/80 dark:border-gray-800 shadow-sm flex flex-col overflow-hidden hover:shadow-md transition-all">
                <!-- Panel Header -->
                <div class="px-4 py-3 sm:px-5 sm:py-3 bg-gray-50/80 dark:bg-gray-800/60 border-b border-gray-200/80 dark:border-gray-800 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
                        <h2 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">Devanagari</h2>
                        <span class="text-xs text-gray-400 dark:text-gray-500 font-normal">(देवनागरी)</span>
                    </div>
                    <button onclick="clearField('deva-text')" class="text-xs text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">Clear</button>
                </div>

                <!-- Textarea -->
                <div class="p-3 sm:p-4 flex-1">
                    <textarea id="deva-text" rows="5" 
                              class="converter-textarea w-full h-full bg-transparent border-0 resize-y text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-600 focus:ring-0 leading-relaxed font-sans text-base sm:text-lg min-h-[120px] sm:min-h-[130px]"
                              placeholder="Type or paste Devanagari text here... / थन देवनागरी लिपिंइ च्वयादिसं"></textarea>
                </div>

                <!-- Panel Footer Stats & Actions -->
                <div class="px-4 py-2.5 sm:px-5 sm:py-3 bg-gray-50/60 dark:bg-gray-800/40 border-t border-gray-200/80 dark:border-gray-800 flex items-center justify-between flex-wrap gap-2">
                    <span id="deva-stats" class="text-[11px] sm:text-xs font-medium text-gray-400 dark:text-gray-500">0 chars • 0 words</span>
                    <button id="btn-copy-deva" onclick="copyText('deva-text', 'btn-copy-deva')" disabled
                            class="px-3 py-1.5 sm:px-3.5 sm:py-1.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-brand hover:text-white dark:hover:bg-brand disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold transition-all flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h6a2 2 0 012 2v2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path></svg>
                        <span>Copy Devanagari</span>
                    </button>
                </div>
            </div>

            <!-- NEPAL LIPI PANEL CARD -->
            <div id="card-newa" class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/80 dark:border-gray-800 shadow-sm flex flex-col overflow-hidden hover:shadow-md transition-all">
                <!-- Panel Header -->
                <div class="px-4 py-3 sm:px-5 sm:py-3 bg-gray-50/80 dark:bg-gray-800/60 border-b border-gray-200/80 dark:border-gray-800 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-brand-light dark:bg-brand"></span>
                        <h2 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">Nepal Lipi</h2>
                        <span class="text-xs text-gray-400 dark:text-gray-500 font-newa">(𑐣𑐾𑐥𑐵𑐮 𑐮𑐶𑐥𑐶)</span>
                    </div>
                    <button onclick="clearField('newa-text')" class="text-xs text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">Clear</button>
                </div>

                <!-- Textarea -->
                <div class="p-3 sm:p-4 flex-1">
                    <textarea id="newa-text" rows="5" 
                              class="converter-textarea w-full h-full bg-transparent border-0 resize-y text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-600 focus:ring-0 leading-relaxed font-newa text-lg sm:text-xl min-h-[120px] sm:min-h-[130px]"
                              placeholder="Converted text will appear here... / 𑐠𑐣 𑐣𑐾𑐥𑐵𑐮 𑐮𑐶𑐥𑐶𑑄𑐂 𑐔𑑂𑐰𑐫𑐵𑐡𑐶..."></textarea>
                </div>

                <!-- Panel Footer Stats & Actions -->
                <div class="px-4 py-2.5 sm:px-5 sm:py-3 bg-gray-50/60 dark:bg-gray-800/40 border-t border-gray-200/80 dark:border-gray-800 flex items-center justify-between flex-wrap gap-2">
                    <span id="newa-stats" class="text-[11px] sm:text-xs font-medium text-gray-400 dark:text-gray-500">0 chars • 0 words</span>
                    <div class="flex items-center gap-2">
                        <button id="btn-download-newa" onclick="downloadNewaText()" disabled
                                class="px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold transition-all flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            <span>Export</span>
                        </button>
                        <button id="btn-copy-newa" onclick="copyText('newa-text', 'btn-copy-newa')" disabled
                                class="px-3 py-1.5 sm:px-3.5 sm:py-1.5 rounded-xl bg-brand text-white hover:bg-brand-hover disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold shadow-sm transition-all flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h6a2 2 0 012 2v2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path></svg>
                            <span>Copy Newa</span>
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- INTERACTIVE SECTION: CHARACTER & ALPHABET REFERENCE MATRIX -->
        <section class="mt-8 sm:mt-10 bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/80 dark:border-gray-800 p-4 sm:p-6 shadow-sm">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 mb-4 sm:mb-6 border-b border-gray-100 dark:border-gray-800 pb-4">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-brand dark:text-brand-light">Interactive Script Guide</span>
                    <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mt-0.5">Nepal Lipi Character Matrix</h3>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Click any letter card to insert its character directly into the converter.</p>
                </div>
                
                <!-- Category Tabs (Horizontal Scroll on Mobile) -->
                <div class="w-full md:w-auto flex items-center gap-1 border-b border-gray-200 dark:border-gray-700 overflow-x-auto pb-1 md:pb-0 scrollbar-none">
                    <button id="ref-tab-consonants" onclick="renderReferenceGrid('consonants')" class="ref-tab-btn px-3 py-1.5 text-xs font-semibold border-b-2 border-brand text-brand dark:text-brand-light transition-all whitespace-nowrap shrink-0">Consonants (व्यंजन)</button>
                    <button id="ref-tab-vowels" onclick="renderReferenceGrid('vowels')" class="ref-tab-btn px-3 py-1.5 text-xs font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-all whitespace-nowrap shrink-0">Vowels (स्वर)</button>
                    <button id="ref-tab-matras" onclick="renderReferenceGrid('matras')" class="ref-tab-btn px-3 py-1.5 text-xs font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-all whitespace-nowrap shrink-0">Matras (मात्रा)</button>
                    <button id="ref-tab-numerals" onclick="renderReferenceGrid('numerals')" class="ref-tab-btn px-3 py-1.5 text-xs font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-all whitespace-nowrap shrink-0">Numerals (अंक)</button>
                </div>
            </div>

            <!-- Dynamic Character Cards Grid -->
            <div id="reference-grid-container" class="grid grid-cols-3 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-12 gap-2 sm:gap-2.5">
                <!-- Cards injected dynamically by script.js -->
            </div>
        </section>

        <!-- INFORMATIONAL SECTION: ABOUT NEPAL LIPI & CALLIJATRA -->
        <section class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
            
            <!-- Card 1: About Nepal Lipi -->
            <div class="bg-white dark:bg-gray-900 rounded-2xl p-5 sm:p-6 border border-gray-200/80 dark:border-gray-800 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-brand/10 dark:bg-brand/20 border border-brand/20 flex items-center justify-center text-brand dark:text-brand-light mb-3 sm:mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    </div>
                    <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white mb-2">What is Nepal Lipi?</h3>
                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        Nepal Lipi (𑐣𑐾𑐥𑐵𑐮 𑐮𑐶𑐥𑐶), also known as Prachalit Nepal Lipi, is the traditional script of Nepal Bhasa. Used extensively across Kathmandu Valley for centuries in stone inscriptions, manuscripts, and literature, it is encoded in Unicode standard (U+11480–U+114DF).
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-800">
                    <a href="/about" class="text-xs font-semibold text-brand dark:text-brand-light hover:underline inline-flex items-center gap-1">
                        Learn more about Nepal Lipi →
                    </a>
                </div>
            </div>

            <!-- Card 2: How Transliteration Works -->
            <div class="bg-white dark:bg-gray-900 rounded-2xl p-5 sm:p-6 border border-gray-200/80 dark:border-gray-800 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-brand/10 dark:bg-brand/20 border border-brand/20 flex items-center justify-center text-brand dark:text-brand-light mb-3 sm:mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                    <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white mb-2">Real-Time Conversion</h3>
                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        This converter maps Devanagari phonemes directly to Unicode Nepal Lipi code points. Special conjuncts (such as ङ्ह, ञ्ह, र्ह) are parsed accurately to maintain authentic manuscript orthography in real-time.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-800">
                    <a href="/resources#converter" class="text-xs font-semibold text-brand dark:text-brand-light hover:underline inline-flex items-center gap-1">
                        Explore Callijatra digital tools →
                    </a>
                </div>
            </div>

            <!-- Card 3: Callijatra Ecosystem -->
            <div class="bg-white dark:bg-gray-900 rounded-2xl p-5 sm:p-6 border border-gray-200/80 dark:border-gray-800 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-brand/10 dark:bg-brand/20 border border-brand/20 flex items-center justify-center text-brand dark:text-brand-light mb-3 sm:mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                    </div>
                    <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white mb-2">More Digital Tools</h3>
                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        Discover Callijatra’s full open suite including <strong class="text-gray-900 dark:text-gray-200 font-semibold">Nepal Lipi Type Newa</strong> app, <strong class="text-gray-900 dark:text-gray-200 font-semibold">Durga Lal Shrestha Font</strong>, and <strong class="text-gray-900 dark:text-gray-200 font-semibold">Nithya Ranjana Webfont</strong> for digital typography.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-800">
                    <a href="/resources" class="text-xs font-semibold text-brand dark:text-brand-light hover:underline inline-flex items-center gap-1">
                        View all Callijatra resources →
                    </a>
                </div>
            </div>

        </section>

    </main>


</Layout>

<script is:inline src="/tools/converter/converter.js"></script>
