---
import Layout from '../../layouts/Layout.astro';

const stylesheetUrl = 'https://callijatra.github.io/tools/webfont/css/nithya-ranjana.css';
const snippet = `@import url('${stylesheetUrl}');

.ranjana {
  font-family: 'NithyaRanjana', sans-serif;
}

/* Newa Unicode text */
.newa {
  font-family: 'NithyaRanjanaNU', sans-serif;
}`;
---

<Layout
  title="Ranjana Webfont — Nithya Ranjana | Callijatra"
  description="Drop-in CSS webfont for rendering Ranjana Lipi on any webpage. Nithya Ranjana for Devanagari Unicode and Newa Unicode."
>
  <link rel="stylesheet" href="/tools/webfont/css/nithya-ranjana.css" />

  <section class="bg-gray-50 dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-2">Webfont</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-3">Render Ranjana Lipi on the web</h1>
      <p class="text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed mb-8">
        Nithya Ranjana is a calligraphic Ranjana typeface. This page hosts the font files and a stylesheet you can link from any site. Licensed under the SIL Open Font License.
      </p>

      <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm overflow-hidden">
        <div class="px-5 sm:px-8 py-8 sm:py-12 min-h-[16rem] flex items-center justify-center bg-[radial-gradient(ellipse_at_top,_#fdf1f0_0%,_#ffffff_70%)] dark:bg-none">
          <p
            id="specimen"
            class="font-nithya-ranjana text-center leading-none text-gray-900 dark:text-white break-words"
            style="font-size: 4.75rem; letter-spacing: 0em;"
          >नित्या रञ्जना</p>
        </div>

        <div class="border-t border-gray-100 dark:border-gray-800 p-5 sm:p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="sm:col-span-2 block text-sm font-medium text-gray-700 dark:text-gray-200">
            Preview text
            <input id="specimen-text" type="text" value="नित्या रञ्जना" spellcheck="false"
              class="mt-1.5 w-full rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-950 px-3 py-2.5 text-gray-900 dark:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-brand" />
          </label>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">
            Size <span id="size-label" class="text-gray-400 font-normal">76px</span>
            <input id="specimen-size" type="range" min="28" max="160" value="76" class="mt-2 w-full accent-[#c0392b]" />
          </label>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">
            Spacing <span id="spacing-label" class="text-gray-400 font-normal">0</span>
            <input id="specimen-spacing" type="range" min="-4" max="24" value="0" class="mt-2 w-full accent-[#c0392b]" />
          </label>
          <fieldset class="sm:col-span-2 flex flex-wrap gap-2">
            <legend class="sr-only">Font version</legend>
            <button type="button" data-family="font-nithya-ranjana" class="family-btn is-active px-3 py-1.5 rounded-full text-xs font-semibold border border-brand bg-brand text-white">Devanagari Unicode</button>
            <button type="button" data-family="font-nithya-ranjana-nu" class="family-btn px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300">Newa Unicode</button>
            <button type="button" data-family="font-nithya-ranjana-ss01" class="family-btn px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300">Stylistic set 1</button>
          </fieldset>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-5 sm:p-6">
          <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Use it on a webpage</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">One stylesheet import. Font files are served from this site.</p>
          <pre class="overflow-x-auto rounded-xl bg-gray-950 text-gray-100 text-xs leading-relaxed p-4"><code>{snippet}</code></pre>
          <p class="mt-3 text-xs text-gray-400">
            <a class="underline hover:text-brand" href="/tools/webfont/OFL.txt">SIL Open Font License</a>
            · <a class="underline hover:text-brand" href="/tools/webfont/CONTRIBUTORS.txt">Contributors</a>
          </p>
        </div>
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-5 sm:p-6">
          <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Two encodings</h2>
          <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-300">
            <li><strong class="text-gray-900 dark:text-white">NithyaRanjana</strong> — Ranjana shapes for text encoded in Devanagari Unicode. This is what the rest of this site uses.</li>
            <li><strong class="text-gray-900 dark:text-white">NithyaRanjanaNU</strong> — the same design for text encoded in Newa (Nepal Lipi) Unicode.</li>
          </ul>
          <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
            Related tools:
            <a class="text-brand dark:text-brand-light font-medium hover:underline" href="/tools/font-switcher">Font switcher</a>
            ·
            <a class="text-brand dark:text-brand-light font-medium hover:underline" href="/tools/transliterate">Transliteration keyboard</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const specimen = document.getElementById('specimen') as HTMLElement;
  const text = document.getElementById('specimen-text') as HTMLInputElement;
  const size = document.getElementById('specimen-size') as HTMLInputElement;
  const spacing = document.getElementById('specimen-spacing') as HTMLInputElement;
  const sizeLabel = document.getElementById('size-label')!;
  const spacingLabel = document.getElementById('spacing-label')!;
  const faces: Record<string, { family: string; features: string }> = {
    'font-nithya-ranjana': { family: "'NithyaRanjana', sans-serif", features: 'normal' },
    'font-nithya-ranjana-nu': { family: "'NithyaRanjanaNU', sans-serif", features: 'normal' },
    'font-nithya-ranjana-ss01': { family: "'NithyaRanjana', sans-serif", features: '"ss01" 1' },
  };
  let face = 'font-nithya-ranjana';

  function paint() {
    const chosen = faces[face];
    specimen.textContent = text.value || ' ';
    specimen.style.fontFamily = chosen.family;
    specimen.style.fontFeatureSettings = chosen.features;
    specimen.style.fontSize = `${size.value}px`;
    specimen.style.letterSpacing = `${Number(spacing.value) / 100}em`;
    sizeLabel.textContent = `${size.value}px`;
    spacingLabel.textContent = `${Number(spacing.value) / 100}`;
  }

  paint();
  text.addEventListener('input', paint);
  size.addEventListener('input', paint);
  spacing.addEventListener('input', paint);

  document.querySelectorAll<HTMLButtonElement>('.family-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      face = btn.dataset.family!;
      paint();
      document.querySelectorAll('.family-btn').forEach((el) => {
        el.classList.remove('is-active', 'bg-brand', 'text-white', 'border-brand');
        el.classList.add('border-gray-200', 'dark:border-gray-700', 'text-gray-600', 'dark:text-gray-300');
      });
      btn.classList.add('is-active', 'bg-brand', 'text-white', 'border-brand');
      btn.classList.remove('border-gray-200', 'text-gray-600');
    });
  });
</script>
