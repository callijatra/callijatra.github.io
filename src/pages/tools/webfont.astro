---
import Layout from '../../layouts/Layout.astro';

const origin = 'https://callijatra.github.io';
const fontBase = `${origin}/tools/webfont/fonts`;
---

<Layout
  title="Ranjana Webfont — Nithya Ranjana | Callijatra"
  description="Specimen studio and integration snippet for the Nithya Ranjana webfont. Tune text, size, spacing, colour, and stylistic sets, then copy the CSS."
>
  <link rel="stylesheet" href="/tools/webfont/css/nithya-ranjana.css" />

  <section class="bg-gray-50 dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-2">Webfont</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-3">Ranjana integration studio</h1>
      <p class="text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed mb-8">
        Try Nithya Ranjana here, then copy CSS that matches what you see. The Devanagari Unicode cut is the default. Switch to Newa Unicode when your text is already encoded in Nepal Lipi.
      </p>

      <div id="studio" class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem] gap-4 items-stretch">
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 min-h-[16rem] flex items-center justify-center px-5 py-10 overflow-hidden">
          <p id="specimen" class="font-nithya-ranjana text-center leading-none break-words" style="font-size:76px;color:#c0392b;">नित्या रञ्जना</p>
        </div>

        <aside class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-4 space-y-4">
          <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400">
            Your text
            <input id="text-input" type="text" value="नित्या रञ्जना" spellcheck="false"
              class="mt-1 w-full rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-950 px-3 py-2 text-sm text-gray-900 dark:text-white" />
          </label>
          <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400">
            Or pick a sample
            <select id="sample-select" class="mt-1 w-full rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-950 px-3 py-2 text-sm text-gray-900 dark:text-white">
              <option value="">Choose a sample…</option>
              <option>नित्या रञ्जना</option>
              <option>ॐ वागिश्वरि मूं</option>
              <option>नेपालभाषा रञ्जना लिपि</option>
              <option>सर्वे भवन्तु सुखिनः</option>
              <option>सङ्गमेन तितिर्याम</option>
              <option>क्षत्रिय ज्ञानत्र श्रद्धा</option>
            </select>
          </label>
          <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400">
            Encoding
            <select id="encoding" class="mt-1 w-full rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-950 px-3 py-2 text-sm text-gray-900 dark:text-white">
              <option value="du">Devanagari Unicode (DU)</option>
              <option value="nu">Newa Unicode (NU)</option>
            </select>
          </label>
          <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400">
            Font size <output id="size-output" class="font-normal">76</output>
            <input id="size-slider" type="range" min="24" max="320" value="76" class="mt-2 w-full accent-[#c0392b]" />
          </label>
          <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400">
            Letter spacing <output id="spacing-output" class="font-normal">0</output>
            <input id="spacing-slider" type="range" min="-2" max="24" value="0" step="0.5" class="mt-2 w-full accent-[#c0392b]" />
          </label>
          <label class="flex items-center justify-between text-xs font-semibold text-gray-500 dark:text-gray-400">
            Colour
            <input id="color-input" type="color" value="#c0392b" class="h-8 w-12 rounded border border-gray-200 dark:border-gray-700 bg-transparent" />
          </label>
          <div>
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2">Stylistic sets</p>
            <div class="grid grid-cols-4 gap-1.5">
              <button type="button" data-ss="ss01" class="ss-btn rounded-lg border border-gray-200 dark:border-gray-700 px-2 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200">ss01</button>
              <button type="button" data-ss="ss02" class="ss-btn rounded-lg border border-gray-200 dark:border-gray-700 px-2 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200">ss02</button>
              <button type="button" data-ss="ss03" class="ss-btn rounded-lg border border-gray-200 dark:border-gray-700 px-2 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200">ss03</button>
              <button type="button" data-ss="ss04" class="ss-btn rounded-lg border border-gray-200 dark:border-gray-700 px-2 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200">ss04</button>
            </div>
            <p id="feature-state" class="mt-2 text-[11px] text-gray-400 break-words">font-feature-settings: normal</p>
          </div>
          <div class="flex gap-2">
            <button type="button" id="random-btn" class="flex-1 rounded-lg bg-brand text-white text-xs font-semibold py-2 hover:bg-brand-hover">Shuffle sample</button>
            <button type="button" id="reset-btn" class="flex-1 rounded-lg border border-gray-200 dark:border-gray-700 text-xs font-semibold py-2 text-gray-700 dark:text-gray-200">Reset</button>
          </div>
        </aside>
      </div>

      <section class="mt-8" aria-labelledby="integration-heading">
        <h2 id="integration-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-1">Integration snippet</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Updates as you change the studio. Paste this into your stylesheet.</p>
        <div class="relative">
          <button type="button" id="copy-css" class="absolute top-3 right-3 rounded-lg bg-white/10 px-3 py-1 text-xs font-semibold text-white hover:bg-white/20">Copy</button>
          <pre id="css-output" class="overflow-x-auto rounded-2xl bg-gray-950 text-gray-100 text-xs leading-relaxed p-4 pr-20"></pre>
        </div>
      </section>

      <section class="mt-10" aria-labelledby="conjuncts-heading">
        <h2 id="conjuncts-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-1">Conjuncts</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Combined consonant forms in the same cut you selected above.</p>
        <div id="conjunct-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
          {['क्ष','त्र','ज्ञ','श्र','द्ध','द्य','क्त','स्त्र','ञ्ज','ङ्क','ण्ड','ह्न'].map((ch) => (
            <div class="conjunct rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 py-4 text-center font-nithya-ranjana text-4xl text-gray-900 dark:text-white">{ch}</div>
          ))}
        </div>
      </section>

      <section class="mt-10" aria-labelledby="credits-heading">
        <h2 id="credits-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-1">Who made it</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Designed and engineered by EkType, with support from Callijatra. Licensed under the SIL Open Font License.</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
          <li class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3"><span class="font-semibold text-gray-900 dark:text-white">Tathagata Biswas</span><span class="block text-gray-500">Type design</span></li>
          <li class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3"><span class="font-semibold text-gray-900 dark:text-white">Noopur Datye</span><span class="block text-gray-500">Type design</span></li>
          <li class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3"><span class="font-semibold text-gray-900 dark:text-white">Ananda K. Maharjan</span><span class="block text-gray-500">Script expert</span></li>
          <li class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3"><span class="font-semibold text-gray-900 dark:text-white">Sarang Kulkarni</span><span class="block text-gray-500">Project management</span></li>
          <li class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3"><span class="font-semibold text-gray-900 dark:text-white">Murali K. Prahalad</span><span class="block text-gray-500">Sponsor and initiator</span></li>
          <li class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3"><span class="font-semibold text-gray-900 dark:text-white">Callijatra</span><span class="block text-gray-500">Support, Kathmandu</span></li>
        </ul>
        <p class="mt-4 text-sm">
          <a class="font-semibold text-brand dark:text-brand-light hover:underline" href="https://ektype.in" target="_blank" rel="noopener noreferrer">EkType</a>
          <span aria-hidden="true"> · </span>
          <a class="font-semibold text-brand dark:text-brand-light hover:underline" href="https://github.com/EkType/Nithya-Ranjana/releases" target="_blank" rel="noopener noreferrer">Font releases</a>
          <span aria-hidden="true"> · </span>
          <a class="font-semibold text-brand dark:text-brand-light hover:underline" href="/tools/webfont/OFL.txt">SIL Open Font License</a>
        </p>
      </section>
    </div>
  </section>
</Layout>

<script define:vars={{ fontBase }}>
  const specimen = document.getElementById('specimen');
  const textInput = document.getElementById('text-input');
  const sampleSelect = document.getElementById('sample-select');
  const encoding = document.getElementById('encoding');
  const sizeSlider = document.getElementById('size-slider');
  const spacingSlider = document.getElementById('spacing-slider');
  const colorInput = document.getElementById('color-input');
  const sizeOutput = document.getElementById('size-output');
  const spacingOutput = document.getElementById('spacing-output');
  const featureState = document.getElementById('feature-state');
  const cssOutput = document.getElementById('css-output');
  const copyBtn = document.getElementById('copy-css');
  const featureButtons = Array.from(document.querySelectorAll('.ss-btn'));
  const conjuncts = Array.from(document.querySelectorAll('.conjunct'));
  const samples = Array.from(sampleSelect.options).map((o) => o.value).filter(Boolean);
  let savedSample = 'नित्या रञ्जना';
  let rawCss = '';

  function activeSets() {
    return featureButtons.filter((b) => b.classList.contains('is-on')).map((b) => b.dataset.ss);
  }

  function featureSettings() {
    const sets = activeSets();
    return sets.length ? sets.map((s) => `"${s}" 1`).join(', ') : 'normal';
  }

  function renderSnippet() {
    const nu = encoding.value === 'nu';
    const family = nu ? 'NithyaRanjanaNU' : 'NithyaRanjana';
    const file = nu ? 'NithyaRanjanaNU-Regular' : 'NithyaRanjanaDU-Regular';
    const features = featureSettings();
    rawCss = `@font-face {
  font-family: '${family}';
  src: url('${fontBase}/${file}.woff2') format('woff2'),
       url('${fontBase}/${file}.woff') format('woff'),
       url('${fontBase}/${file}.otf') format('opentype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

.nithya-ranjana {
  font-family: '${family}', sans-serif;
  font-size: ${sizeSlider.value}px;
  letter-spacing: ${spacingSlider.value}px;
  color: ${colorInput.value};
  font-feature-settings: ${features};
}`;
    cssOutput.textContent = rawCss;
  }

  function apply() {
    const nu = encoding.value === 'nu';
    specimen.style.fontFamily = nu ? "'NithyaRanjanaNU', sans-serif" : "'NithyaRanjana', sans-serif";
    specimen.style.fontSize = `${sizeSlider.value}px`;
    specimen.style.letterSpacing = `${spacingSlider.value}px`;
    specimen.style.color = colorInput.value;
    specimen.style.fontFeatureSettings = featureSettings();
    sizeOutput.textContent = sizeSlider.value;
    spacingOutput.textContent = spacingSlider.value;
    featureState.textContent = `font-feature-settings: ${featureSettings()}`;
    conjuncts.forEach((el) => {
      el.style.fontFamily = specimen.style.fontFamily;
      el.style.fontFeatureSettings = specimen.style.fontFeatureSettings;
    });
    renderSnippet();
  }

  textInput.addEventListener('input', () => {
    specimen.textContent = textInput.value || ' ';
    sampleSelect.value = '';
    renderSnippet();
  });
  sampleSelect.addEventListener('change', () => {
    if (!sampleSelect.value) return;
    savedSample = sampleSelect.value;
    textInput.value = savedSample;
    specimen.textContent = savedSample;
  });
  featureButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const on = button.classList.toggle('is-on');
      button.classList.toggle('bg-brand', on);
      button.classList.toggle('text-white', on);
      button.classList.toggle('border-brand', on);
      apply();
    });
  });
  document.getElementById('random-btn').addEventListener('click', () => {
    const pool = samples.filter((s) => s !== savedSample);
    savedSample = pool[Math.floor(Math.random() * pool.length)];
    textInput.value = savedSample;
    specimen.textContent = savedSample;
    sampleSelect.value = savedSample;
  });
  document.getElementById('reset-btn').addEventListener('click', () => {
    sizeSlider.value = '76';
    spacingSlider.value = '0';
    colorInput.value = '#c0392b';
    encoding.value = 'du';
    featureButtons.forEach((b) => {
      b.classList.remove('is-on', 'bg-brand', 'text-white', 'border-brand');
    });
    savedSample = 'नित्या रञ्जना';
    textInput.value = savedSample;
    specimen.textContent = savedSample;
    sampleSelect.value = '';
    apply();
  });
  [sizeSlider, spacingSlider, colorInput, encoding].forEach((control) => {
    control.addEventListener('input', apply);
  });
  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(rawCss);
    copyBtn.textContent = 'Copied';
    setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1600);
  });
  apply();
</script>
