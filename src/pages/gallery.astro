---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gallery - Callijatra Foundation" description="Events, workshops, exhibitions, and community highlights from Callijatra Foundation.">

  <section class="py-12 sm:py-20 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light">Community</span>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">Events &amp; Gallery</h1>
        <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
          Highlights from our workshops, exhibitions, and cultural events.
        </p>
      </div>

      <!-- Gallery Grid -->
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 [column-fill:_balance]">
        <!-- Event 1 -->
        <figure class="mb-4 break-inside-avoid rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group">
          <img src="/images/events/events_1.jpg" alt="Callijatra event and calligraphy workshop" class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          <figcaption class="sr-only">Callijatra event</figcaption>
        </figure>

        <!-- Event 2 -->
        <figure class="mb-4 break-inside-avoid rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group">
          <img src="/images/events/events_2.jpg" alt="Callijatra exhibition and community gathering" class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          <figcaption class="sr-only">Callijatra exhibition</figcaption>
        </figure>

        <!-- Event 3 -->
        <figure class="mb-4 break-inside-avoid rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group">
          <img src="/images/events/events_3.jpg" alt="Callijatra workshop participants" class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          <figcaption class="sr-only">Callijatra workshop</figcaption>
        </figure>

        <!-- Event 4 -->
        <figure class="mb-4 break-inside-avoid rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group">
          <img src="/images/events/events_4.jpg" alt="Callijatra cultural event" class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          <figcaption class="sr-only">Callijatra cultural event</figcaption>
        </figure>

        <!-- Banner 1 -->
        <figure class="mb-4 break-inside-avoid rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group">
          <img src="/images/banners/banner_1.jpg" alt="Callijatra banner showcasing indigenous scripts" class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          <figcaption class="sr-only">Callijatra banner</figcaption>
        </figure>

        <!-- App feature images -->
        <figure class="mb-4 break-inside-avoid rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group">
          <img src="/images/apps/callijatra-calligraphy-feature.jpg" alt="Callijatra Calligraphy app preview" class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          <figcaption class="sr-only">Callijatra Calligraphy app</figcaption>
        </figure>

        <figure class="mb-4 break-inside-avoid rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group">
          <img src="/images/apps/nepal-lipi-keyboard-feature.jpg" alt="Nepal Lipi Keyboard app preview" class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          <figcaption class="sr-only">Nepal Lipi Keyboard app</figcaption>
        </figure>
      </div>

      <div class="text-center mt-12 flex flex-col sm:flex-row gap-3 items-center justify-center">
        <a href="https://www.instagram.com/callijatra" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand text-white font-medium hover:bg-brand-hover transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Follow on Instagram
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <a href="https://drive.google.com/drive/folders/135KGT46EKb3QBMHx5hosfX_lpJECo6ki" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 128 128" aria-hidden="true">
            <path fill="#EA4335" d="M44.59 4.21a63.28 63.28 0 004.33 120.9 67.6 67.6 0 0032.36.35 57.13 57.13 0 0025.9-13.46 57.44 57.44 0 0016-26.26 74.33 74.33 0 001.61-33.58H65.27v24.69h34.47a29.72 29.72 0 01-12.66 19.52 36.16 36.16 0 01-13.93 5.5 41.29 41.29 0 01-15.1 0A37.16 37.16 0 0144 95.74a39.3 39.3 0 01-14.5-19.42 38.31 38.31 0 010-24.63 39.25 39.25 0 019.18-14.91A37.17 37.17 0 0176.13 27a34.28 34.28 0 0113.64 8q5.83-5.8 11.64-11.63c2-2.09 4.18-4.08 6.15-6.22A61.22 61.22 0 0087.2 4.59a64 64 0 00-42.61-.38z"/><path fill="#34A853" d="M44.59 4.21a64 64 0 0142.61.37 61.22 61.22 0 0120.35 12.62c-2 2.14-4.11 4.14-6.15 6.22Q95.58 29.23 89.77 35a34.28 34.28 0 00-13.64-8 37.17 37.17 0 00-37.46 9.74 39.25 39.25 0 00-9.18 14.91L8.76 35.6A63.53 63.53 0 0144.59 4.21z"/><path fill="#FBBC05" d="M3.26 51.5a62.93 62.93 0 015.5-15.9l20.73 16.09a38.31 38.31 0 000 24.63q-10.36 8-20.73 16.08a63.33 63.33 0 01-5.5-40.9z"/><path fill="#4285F4" d="M65.27 52.15h59.52a74.33 74.33 0 01-1.61 33.58 57.44 57.44 0 01-16 26.26c-6.69-5.22-13.41-10.4-20.1-15.62a29.72 29.72 0 0012.66-19.54H65.27c-.01-8.22 0-16.45 0-24.68z"/><path fill="#0D652D" d="M8.75 92.4q10.37-8 20.73-16.08A39.3 39.3 0 0044 95.74a37.16 37.16 0 0014.08 6.08 41.29 41.29 0 0015.1 0 36.16 36.16 0 0013.93-5.5c6.69 5.22 13.41 10.4 20.1 15.62a57.13 57.13 0 01-25.9 13.47 67.6 67.6 0 01-32.36-.35 63 63 0 01-23-11.59A63.73 63.73 0 018.75 92.4z"/>
          </svg>
          View Full Gallery on Drive
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

</Layout>