<script>
  // Clicking anywhere on a resource card navigates to its href,
  // unless the click was on a pill link (which has its own href).
  document.querySelectorAll<HTMLElement>('.resource-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.resource-pill')) return;
      const href = card.dataset.cardHref;
      if (href) window.location.href = href;
    });
  });
</script>

