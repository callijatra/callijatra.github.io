---
import Layout from '../layouts/Layout.astro';
import StoreBadge from '../components/StoreBadge.astro';
---

<Layout
  title="Resources — Callijatra Foundation"
  description="Explore open-source tools, fonts, web widgets, and mobile apps by Callijatra Foundation for digitizing Ranjana Lipi, Nepal Lipi and indigenous scripts."
>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 dark:from-gray-950 dark:via-gray-900 dark:to-gray-950 text-white py-24 text-center">
    <div class="parallax-orb absolute -top-16 -left-16 w-80 h-80 rounded-full bg-[#c0392b]/20 blur-3xl pointer-events-none" data-speed="0.3" aria-hidden="true"></div>
    <div class="parallax-orb absolute -bottom-20 -right-20 w-96 h-96 rounded-full bg-[#c0392b]/10 blur-3xl pointer-events-none" data-speed="0.18" aria-hidden="true"></div>

    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand-light bg-red-900/40 px-3 py-1 rounded-full border border-red-700/40 mb-4">
        What We Offer
      </span>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold mb-6 tracking-tight">
        Our Resources
      </h1>
      <p class="text-gray-400 leading-relaxed max-w-xl mx-auto mb-10">
        Open tools, fonts, web widgets, and mobile apps to bring indigenous scripts into the digital age — freely available to everyone.
      </p>

      <!-- Frosted glass quick-nav pills -->
      <nav aria-label="Jump to resource" class="flex flex-wrap justify-center gap-2">
        {[
          { href: '#apps',            label: 'Mobile Apps'             },
          { href: '#durgalal-font',   label: 'Durga Lal Shrestha Font' },
          { href: '#newa-fonts',      label: 'Newa Fonts'              },
          { href: '#converter',       label: 'Unicode Converter'       },
          { href: '#ranjana-webfont', label: 'Ranjana Webfont'         },
          { href: '#font-switcher',   label: 'Font Switcher'           },
          { href: '#transliteration', label: 'Transliteration'         },
        ].map(({ href, label }) => (
          <a
            href={href}
            class="px-4 py-1.5 rounded-full text-sm font-medium
                   bg-brand/10 hover:bg-brand/20 dark:bg-white/10 dark:hover:bg-white/20
                   border border-brand/20 hover:border-brand/40 dark:border-white/20 dark:hover:border-white/40
                   text-brand hover:text-brand-hover dark:text-white/80 dark:hover:text-white
                   backdrop-blur-md
                   transition-all duration-200"
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ── RESOURCE BLOCKS ───────────────────────────────────────────────── -->
  <div class="resource-stream">

    <!-- ═══════════════════════════════════════════════════════════════════
         1. Mobile Apps  (visual LEFT, text RIGHT)
    ════════════════════════════════════════════════════════════════════ -->
    <section id="apps" class="resource-block py-24 bg-white dark:bg-gray-950">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="resource-row grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

          <div class="resource-visual order-1 lg:order-1 flex flex-col gap-5">

            <div class="rounded-2xl overflow-hidden border border-gray-100 dark:border-gray-800 shadow-md">
              <img src="https://img.youtube.com/vi/_O9ri4kz0mE/0.jpg" alt="Nepal Lipi – Type Newa app" class="w-full object-cover" loading="lazy" />
              <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex items-center justify-between gap-3 flex-wrap">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Nepal Lipi – Type Newa</span>
                <div class="flex gap-2 items-center">
                  <StoreBadge store="google" href="https://play.google.com/store/apps/details?id=com.paoneking.nepallipi_typenewa&hl=en" />
                  <StoreBadge store="apple" href="https://apps.apple.com/np/app/nepal-lipi-ranjana-lipi/id1458885224" />
                </div>
              </div>
            </div>

            <div class="rounded-2xl overflow-hidden border border-gray-100 dark:border-gray-800 shadow-md">
              <img src="/images/apps/nepal-lipi-keyboard-feature.jpg" alt="Nepal Lipi Keyboard app" class="w-full object-cover" loading="lazy" />
              <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex items-center justify-between gap-3 flex-wrap">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Nepal Lipi Keyboard</span>
                <div class="flex gap-2 items-center">
                  <StoreBadge store="google" href="https://play.google.com/store/apps/details?id=com.paoneking.nepallipikeyboard&hl=en" />
                  <StoreBadge store="apple" href="https://apps.apple.com/np/app/nepal-lipi-keyboard/id1539281394" />
                </div>
              </div>
            </div>

            <div class="rounded-2xl overflow-hidden border border-gray-100 dark:border-gray-800 shadow-md">
              <img src="/images/apps/callijatra-calligraphy-feature.jpg" alt="Callijatra Calligraphy app" class="w-full object-cover" loading="lazy" />
              <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex flex-col gap-2">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  Callijatra Calligraphy
                  <span class="ml-2 text-xs bg-yellow-100 dark:bg-yellow-900/40 text-yellow-800 dark:text-yellow-300 font-medium px-2 py-0.5 rounded-full">Review pending</span>
                </span>
                <div class="flex gap-2 items-center flex-wrap">
                  <a href="https://github.com/callijatra/callijatra.github.io/releases/download/callijatra-calligraphy-v1.0.0-build2/callijatra-calligraphy-1.0.0-build2.apk"
                     download aria-label="Download APK"
                     class="inline-flex items-center gap-2 h-9 px-3 rounded-lg bg-black text-white text-xs hover:opacity-85 active:scale-95 transition-all duration-150">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M17.523 15.341a.694.694 0 0 1-.694-.695.694.694 0 0 1 .694-.694.694.694 0 0 1 .694.694.694.694 0 0 1 .694.694.694.694 0 0 1-.694.695m-11.046 0a.694.694 0 0 1-.694-.695.694.694 0 0 1 .694-.694.694.694 0 0 1 .694.694.694.694 0 0 1-.694.695M17.69 9.535l1.385-2.4a.288.288 0 0 0-.105-.393.288.288 0 0 0-.393.105l-1.402 2.428A8.415 8.415 0 0 0 12 8.297a8.415 8.415 0 0 0-3.175.978L7.423 6.847a.288.288 0 0 0-.393-.105.288.288 0 0 0-.105.393l1.385 2.4C5.824 10.812 4.098 13.048 4 15.7h16c-.098-2.652-1.824-4.888-4.31-6.165"/>
                    </svg>
                    Download APK (61 MB)
                  </a>
                </div>
                <p class="text-xs text-gray-400 dark:text-gray-500">Version 1.0.0 · Android 7.0+</p>
              </div>
            </div>

          </div>

          <div class="resource-text order-2 lg:order-2 lg:sticky lg:top-24">
            <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-3">Mobile Apps · Android &amp; iOS</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              Apps for<br/>Indigenous Scripts
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
              A suite of mobile apps that make Nepal Lipi and Ranjana Lipi practical for everyday digital use — from typing and keyboarding to practising the art of calligraphy.
            </p>
            <div class="space-y-5 mb-8">
              <div>
                <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-1">Nepal Lipi – Type Newa</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Read and write in Nepal Lipi (Newa Script) and Ranjana Lipi. Available on Android and iOS.</p>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-1">Nepal Lipi Keyboard</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">A system-wide keyboard for typing Nepalbhasa and Nepali in Nepal Lipi and Devanagari across any app.</p>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-1">Callijatra Calligraphy</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Write Ranjana, Prachalit, and Devanagari with simulated broad-nib pen strokes — ink and paper feel on your screen. Currently pending App Store review.</p>
              </div>
            </div>
            <a href="https://play.google.com/store/apps/developer?id=Callijatra&hl=en" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-semibold hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              View All on Play Store
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         2. Durga Lal Shrestha Font  (text LEFT, visual RIGHT)
    ════════════════════════════════════════════════════════════════════ -->
    <section id="durgalal-font" class="resource-block py-24
      bg-[radial-gradient(ellipse_at_top_right,_#fdf1f0_0%,_#f9f5f4_50%,_#f3ede9_100%)]
      dark:bg-none dark:bg-gray-900 border-y border-red-100/60 dark:border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="resource-row grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <div class="resource-text order-2 lg:order-1">
            <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-3">Font Download · Free</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              Durga Lal Shrestha<br/>Handwritten Font
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
              A faithful digital preservation of the handwriting of <strong class="text-gray-800 dark:text-gray-200">Janakabi Durga Lal Shrestha</strong> — one of Nepal's most celebrated Newari poets — crafted for literary typography and cultural publications.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Authentic handwritten character forms, digitized with precision
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Ideal for book covers, poetry collections, and heritage publications
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Free to download and use in personal and cultural projects
              </li>
            </ul>
            <a href="https://drive.google.com/drive/folders/101GYVHsxILe09p_Dly3hzgF30CTUo2rh" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand text-white font-semibold hover:bg-brand-hover transition-colors shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              Download Font
            </a>
          </div>

          <div class="resource-visual order-1 lg:order-2">
            <div class="rounded-3xl overflow-hidden border border-gray-100 dark:border-gray-800 shadow-lg">
              <div class="bg-gray-900 text-white text-xs font-medium px-5 py-3 text-center tracking-wide uppercase border-b border-gray-700">
                Font Preview
              </div>
              <img src="/images/gifs/durgalalfont.gif" alt="Durga Lal Shrestha handwritten font animation" class="w-full" loading="lazy" />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         3. Nithya Ranjana / Newa Fonts  (visual LEFT, text RIGHT)
    ════════════════════════════════════════════════════════════════════ -->
    <section id="newa-fonts" class="resource-block py-24 bg-white dark:bg-gray-950">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="resource-row grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <div class="resource-visual order-1 lg:order-1">
            <div class="rounded-3xl overflow-hidden border border-red-100 dark:border-gray-800 shadow-lg">
              <div class="bg-gray-900 text-white text-xs font-medium px-5 py-3 text-center tracking-wide uppercase border-b border-gray-700">
                Nithya Ranjana — Font Preview
              </div>
              <img
                src="https://github.com/EkType/Nithya-Ranjana/raw/385f8d73ea7061dde0598744db0d31b6e6a1a555/Promotion/NithyaRanjana.gif"
                alt="Nithya Ranjana font glyphs animation"
                class="w-full"
                loading="lazy"
              />
            </div>
          </div>

          <div class="resource-text order-2 lg:order-2">
            <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-3">Font Download · Free</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              Nithya Ranjana<br/>&amp; Newa Fonts
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
              Nithya Ranjana is an innovative Unicode typeface by <a href="https://ektype.in" target="_blank" rel="noopener noreferrer" class="text-brand dark:text-brand-light underline underline-offset-2">EkType</a> that bridges the ancient aesthetic of Ranjana calligraphy with modern digital typography — the most comprehensive digital Ranjana font available.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Full Unicode Ranjana Lipi coverage with OpenType features
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                WOFF2 web-optimised format for fast page loads
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Suitable for signage, manuscripts, digital art, and web content
              </li>
            </ul>
            <a href="https://drive.google.com/drive/folders/1rQ230ntI61BmHbvrksQZ82tLmLzSuXw8" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand text-white font-semibold hover:bg-brand-hover transition-colors shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              Download Newa Fonts
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         4. Nepal Lipi Unicode Converter  (text LEFT, visual RIGHT)
    ════════════════════════════════════════════════════════════════════ -->
    <section id="converter" class="resource-block py-24
      bg-[radial-gradient(ellipse_at_top,_#fdf1f0_0%,_#f9f5f4_50%,_#f3ede9_100%)]
      dark:bg-none dark:bg-gray-900 border-y border-red-100/60 dark:border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="resource-row grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <div class="resource-text order-2 lg:order-1">
            <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-3">Web Tool · Open Source</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              Nepal Lipi<br/>Unicode Converter
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
              Instantly convert text between Devanagari and Nepal Lipi (Newa Script) — the ancient script used for over a millennium in the Kathmandu Valley.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Bidirectional conversion — Devanagari to Nepal Lipi and back
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Unicode-compliant output — works with any font supporting Nepal Lipi
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Useful for writers, publishers, and researchers digitizing classical texts
              </li>
            </ul>
            <a href="https://suyogyart.github.io/DTNConverter" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand text-white font-semibold hover:bg-brand-hover transition-colors shadow-sm">
              Open Converter
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

          <div class="resource-visual order-1 lg:order-2">
            <a href="https://suyogyart.github.io/DTNConverter" target="_blank" rel="noopener noreferrer"
               class="group block rounded-3xl overflow-hidden border border-gray-100 dark:border-gray-800 shadow-lg hover:shadow-xl transition-shadow bg-white dark:bg-gray-900">
              <div class="bg-gray-900 text-white text-xs font-medium px-5 py-3 text-center tracking-wide uppercase border-b border-gray-700">
                Nepal Lipi Unicode Converter — Live Demo
              </div>
              <div class="p-10 flex flex-col items-center gap-6 bg-white dark:bg-gray-950">
                <p class="text-5xl sm:text-6xl font-bold text-brand dark:text-brand-light leading-none tracking-tight">कखग</p>
                <div class="flex items-center gap-4">
                  <div class="h-px w-12 bg-gray-300 dark:bg-gray-600"></div>
                  <span class="text-2xl text-gray-400">↕</span>
                  <div class="h-px w-12 bg-gray-300 dark:bg-gray-600"></div>
                </div>
                <p class="text-5xl sm:text-6xl font-bold text-brand dark:text-brand-light leading-none tracking-tight">𑐎𑐏𑐐</p>
                <span class="text-xs text-gray-400 dark:text-gray-500 tracking-widest uppercase">Devanagari ↔ Nepal Lipi</span>
              </div>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         5. Ranjana Lipi Webfont  (visual LEFT, text RIGHT)
    ════════════════════════════════════════════════════════════════════ -->
    <section id="ranjana-webfont" class="resource-block py-24 bg-white dark:bg-gray-950">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="resource-row grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <div class="resource-visual order-1 lg:order-1">
            <div class="rounded-3xl overflow-hidden border border-red-100 dark:border-gray-800 shadow-lg bg-white dark:bg-gray-800">
              <div class="bg-gray-900 text-white text-xs font-medium px-5 py-3 text-center tracking-wide uppercase border-b border-gray-700">
                Nithya Ranjana — Live Render
              </div>
              <div class="p-10 flex flex-col items-center gap-5">
                <p class="text-6xl sm:text-7xl text-brand dark:text-brand-light font-nithya-ranjana leading-none">रञ्जना</p>
                <p class="text-4xl text-brand/70 dark:text-brand-light/70 font-nithya-ranjana leading-none">लिपि</p>
                <div class="mt-2 rounded-lg bg-gray-50 dark:bg-gray-900 px-4 py-2 font-mono text-xs text-gray-500 dark:text-gray-400 text-center">
                  &lt;link rel="stylesheet" href="nithya-ranjana.css"&gt;
                </div>
              </div>
            </div>
          </div>

          <div class="resource-text order-2 lg:order-2">
            <span class="inline-block text-xs font-semibold tracking-widest uppercase text-brand dark:text-brand-light mb-3">CSS Webfont · Free</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              Render Ranjana Lipi<br/>on Webpages
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
              A drop-in CSS solution to display the ancient Ranjana script on any website — no server-side processing needed. Just include the stylesheet and the font renders instantly.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Single CSS import — works in any HTML page or CMS
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Uses the Nithya Ranjana WOFF2 font, optimised for web performance
              </li>
              <li class="flex items-start gap-3 text-gray-500 dark:text-gray-400 text-sm">
                <span class="text-brand dark:text-brand-light mt-0.5 shrink-0">✦</span>
                Ideal for blogs, news portals, and cultural institutions publishing in Newa
              </li>
            </ul>
            <a href="https://callijatra.github.io/nithya-ranjana-webfont1" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand text-white font-semibold hover:bg-brand-hover transition-colors shadow-sm">
              View Integration Guide
